FUNCTIONS_REGION=europe-west1
ENFORCE_APP_CHECK=false
# In Firebase runtimes the bucket is derived from FIREBASE_CONFIG/project ID.
# Optional local override only:
# APP_STORAGE_BUCKET=your-project-id.firebasestorage.app
# Firebase/Google Cloud runtimes auto-detect GOOGLE_CLOUD_PROJECT/GCLOUD_PROJECT.
# Optional override for local runs only:
# VERTEX_AI_PROJECT_ID=your-google-cloud-project-id
VERTEX_AI_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TUTOR_THINKING_LEVEL=LOW
GEMINI_STRUCTURED_THINKING_LEVEL=MEDIUM
LLM_SERVICE_TIMEOUT_MS=45000
MAX_COURSE_IMAGES=8
TUTOR_DAILY_QUESTION_LIMIT=20
LOG_LEVEL=info
