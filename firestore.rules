rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================

    function isAuthenticated() {
      return request.auth != null
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountStatus', 'active')
            in ['suspended', 'deleted']));
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isActiveOrLegacyStaffAccount() {
      return !('accountStatus' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active';
    }

    function isRole(role) {
      return isAuthenticated() && getUserRole() == role;
    }

    function isSuperAdmin() {
      return isRole('superAdmin') || isRole('super_admin');
    }

    function isAdmin() {
      return (isRole('admin') && isActiveOrLegacyStaffAccount()) || isSuperAdmin();
    }

    function isTeacher() {
      return isRole('teacher') && isActiveOrLegacyStaffAccount();
    }

    function isStaff() {
      return isTeacher() || isAdmin() || isSuperAdmin();
    }

    function isParent() {
      return isRole('parent');
    }

    function isStudent() {
      return isRole('student');
    }

    // L'etablissement n'est jamais declare par l'utilisateur : il est attache
    // par un workflow serveur (approbation du personnel, changement d'ecole
    // par la super-administration, acces familial). establishmentId et
    // establishmentName sont donc absents des cles de creation.
    function establishmentAuthorityKeys() {
      return ['establishmentId', 'establishmentName', 'establishmentVerified'];
    }

    function userCreateKeys() {
      return [
        'uid',
        'email',
        'firstName',
        'lastName',
        'phoneNumber',
        'role',
        'avatarId',
        'photoUrl',
        'classLevel',
        'series',
        'tutorId',
        'profileCompleted',
        'tourGuideSeen',
        'createdAt',
        'updatedAt'
      ];
    }

    function userOwnerUpdateKeys() {
      return [
        'firstName',
        'lastName',
        'phoneNumber',
        'avatarId',
        'photoUrl',
        'profileCompleted',
        'tourGuideSeen',
        'updatedAt'
      ];
    }

    function studentProfileCreateKeys() {
      return [
        'uid',
        'firstName',
        'lastName',
        'email',
        'classLevel',
        'series',
        'points',
        'xp', // Ancienne clé tolérée uniquement pour les anciens clients.
        'level',
        'streak',
        'tutorId',
        'preferences',
        'consents',
        'profileCompleted',
        'createdAt',
        'updatedAt'
      ];
    }

    function studentProfileOwnerUpdateKeys() {
      return [
        'firstName',
        'lastName',
        'tutorId',
        'preferences',
        'consents',
        'profileCompleted',
        'updatedAt'
      ];
    }

    function isPublicUserCreate(uid) {
      return isOwner(uid)
        && request.resource.data.keys().hasOnly(userCreateKeys())
        && request.resource.data.uid == uid
        && request.resource.data.role in ['student', 'parent'];
    }

    function isUserOwnerUpdate() {
      // role and establishmentId are deliberately absent from the update
      // allowlist. Avoid dereferencing either field here: historical documents
      // may not contain establishmentId, and a missing map key turns an
      // otherwise safe retry into an evaluation error.
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(userOwnerUpdateKeys());
    }

    function isStudentProfileCreate(uid) {
      return isOwner(uid)
        && (!exists(/databases/$(database)/documents/users/$(uid)) || isStudent())
        && request.resource.data.keys().hasOnly(studentProfileCreateKeys())
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasAny(['points', 'xp'])
        && (!('points' in request.resource.data) || request.resource.data.points == 0)
        && (!('xp' in request.resource.data) || request.resource.data.xp == 0)
        && request.resource.data.level == 1;
    }

    function isStudentProfileOwnerUpdate() {
      // Sensitive academic/bootstrap fields are immutable because none of
      // them are in studentProfileOwnerUpdateKeys(). The allowlist is enough
      // and remains valid for legacy documents with missing optional keys.
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(studentProfileOwnerUpdateKeys());
    }

    function isLessonFavoriteCreate() {
      return request.resource.data.keys().hasOnly(['isFavorite', 'updatedAt'])
        && request.resource.data.isFavorite is bool;
    }

    function isLessonFavoriteUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isFavorite', 'updatedAt'])
        && request.resource.data.isFavorite is bool;
    }

    function getUserEstablishment() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('establishmentId', '');
    }

    function isSameEstablishment(establishmentId) {
      return isAuthenticated()
        && establishmentId is string
        && establishmentId.size() > 0
        && getUserEstablishment() == establishmentId;
    }

    function isStaffForStudent(studentId) {
      return (isTeacher() || isAdmin())
        && isSameEstablishment(
          get(/databases/$(database)/documents/users/$(studentId)).data.establishmentId);
    }

    // A school head can manage the class, but its pupil roster remains under
    // trusted enrollment control, including when deleting the class itself.
    function classHasNoStudents(data) {
      return data.get('studentIds', []) == []
        && data.get('students', []) == []
        && data.get('enrollments', []) == []
        && data.get('studentCount', 0) == 0;
    }

    function classRosterUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['studentIds', 'students', 'enrollments', 'studentCount']);
    }

    function isAssignedTeacherForClass(classId) {
      return isTeacher()
        && exists(/databases/$(database)/documents/classes/$(classId))
        && (
          request.auth.uid == get(/databases/$(database)/documents/classes/$(classId)).data.mainTeacherId
          || request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.teacherIds
        );
    }

    // Vérifie qu'un parent est lié à un enfant
    function isLinkedParent(studentUid) {
      return isParent() &&
        exists(/databases/$(database)/documents/children_links/$(request.auth.uid + '_' + studentUid)) &&
        get(/databases/$(database)/documents/children_links/$(request.auth.uid + '_' + studentUid)).data.status == 'approved';
    }

    // =============================================
    // USERS
    // =============================================
    match /users/{uid} {
      // A disabled account can read its own status to leave the UI cleanly.
      allow read: if (request.auth != null && request.auth.uid == uid)
                  || isSuperAdmin()
                  || (isAdmin() && isSameEstablishment(resource.data.establishmentId))
                  || (isTeacher() && isSameEstablishment(resource.data.establishmentId))
                  || isLinkedParent(uid);
      allow create: if isPublicUserCreate(uid);
      allow update: if (isOwner(uid) && isUserOwnerUpdate())
                    || isSuperAdmin()
                    || (isAdmin() && isSameEstablishment(resource.data.establishmentId) && isUserOwnerUpdate());
      allow delete: if isSuperAdmin();
    }

    // =============================================
    // ESTABLISHMENTS
    // =============================================
    match /establishments/{establishmentId} {
      allow read: if isAuthenticated() && (
                    isSuperAdmin()
                    || isSameEstablishment(establishmentId)
                  );
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin()
                    || (isAdmin() && isSameEstablishment(establishmentId));
      allow delete: if isSuperAdmin();
    }

    // =============================================
    // STUDENT PROFILES
    // =============================================
    match /student_profiles/{uid} {
      allow read: if isOwner(uid)
                  || isSuperAdmin()
                  || isLinkedParent(uid)
                  || (isTeacher() && isSameEstablishment(
                       get(/databases/$(database)/documents/users/$(uid)).data.establishmentId))
                  || (isAdmin() && isSameEstablishment(
                       get(/databases/$(database)/documents/users/$(uid)).data.establishmentId));
      allow create: if isStudentProfileCreate(uid);
      allow update: if (isOwner(uid) && isStudentProfileOwnerUpdate())
                    || isSuperAdmin()
                    || (isAdmin() && isSameEstablishment(
                         get(/databases/$(database)/documents/users/$(uid)).data.establishmentId)
                         && isStudentProfileOwnerUpdate());
      allow delete: if isSuperAdmin();

      match /lessonProgress/{progressId} {
        allow read: if isOwner(uid)
                    || isSuperAdmin()
                    || isLinkedParent(uid)
                    || (isTeacher() && isSameEstablishment(
                         get(/databases/$(database)/documents/users/$(uid)).data.establishmentId))
                    || (isAdmin() && isSameEstablishment(
                         get(/databases/$(database)/documents/users/$(uid)).data.establishmentId));
        allow create: if isOwner(uid) && isLessonFavoriteCreate();
        allow update: if isOwner(uid) && isLessonFavoriteUpdate();
        allow delete: if false;
      }
    }

    // =============================================
    // PARENT PROFILES
    // =============================================
    match /parent_profiles/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin();
      // Un parent suit l'ecole de ses enfants : il ne s'en declare aucune.
      allow create: if isOwner(uid)
                    && !request.resource.data.keys().hasAny(establishmentAuthorityKeys());
      allow update: if (isOwner(uid)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(establishmentAuthorityKeys()))
                    || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // =============================================
    // TEACHER PROFILES
    // =============================================
    match /teacher_profiles/{uid} {
      allow read: if isOwner(uid)
                  || isSuperAdmin()
                  || (isAdmin() && isSameEstablishment(
                       get(/databases/$(database)/documents/users/$(uid)).data.establishmentId))
                  || (isStudent() && isSameEstablishment(
                       get(/databases/$(database)/documents/users/$(uid)).data.establishmentId));
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin()
                    || (isAdmin() && isSameEstablishment(
                         get(/databases/$(database)/documents/users/$(uid)).data.establishmentId));
      allow delete: if isSuperAdmin();
    }

    // =============================================
    // ADMIN PROFILES
    // =============================================
    match /admin_profiles/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // =============================================
    // CHILDREN LINKS (parent <-> enfant)
    // =============================================
    match /children_links/{linkId} {
      allow read: if isAuthenticated() && (
                    request.auth.uid == resource.data.parentId
                    || request.auth.uid == resource.data.studentId
                    || isSuperAdmin()
                    || (isAdmin() && isStaffForStudent(resource.data.studentId))
                  );
      // Identifiant canonique {parentId}_{studentId} : c'est celui que
      // isLinkedParent() interroge. Un lien a un autre identifiant pourrait
      // etre approuve pour un autre parent que son createur.
      allow create: if isParent()
                    && request.auth.uid == request.resource.data.parentId
                    && linkId == request.resource.data.parentId + '_' + request.resource.data.studentId
                    && request.resource.data.studentId != request.auth.uid
                    && request.resource.data.keys().hasOnly([
                         'parentId',
                         'studentId',
                         'status',
                         'createdAt',
                         'updatedAt'
                       ])
                    && request.resource.data.parentId is string
                    && request.resource.data.studentId is string
                    && request.resource.data.status == 'pending';
      allow update: if isSuperAdmin()
                    || (isAdmin() && isSameEstablishment(
                         get(/databases/$(database)/documents/users/$(resource.data.studentId)).data.establishmentId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'updatedAt'])
                        && request.resource.data.status in ['pending', 'approved', 'rejected']);
      allow delete: if isSuperAdmin();
    }

    // =============================================
    // SUBJECTS
    // =============================================
    match /{path=**}/subjects/{subjectId} {
      allow read: if isStaff() && mayReadContentScope(contentScopeIdOf(resource.data));
      allow create: if isSuperAdmin()
                    || (isAdmin() && isSameEstablishment(request.resource.data.establishmentId));
      allow update: if isSuperAdmin()
                    || (isAdmin() && isSameEstablishment(resource.data.establishmentId)
                        && isSameEstablishment(request.resource.data.establishmentId))
                    || (isTeacher() && request.auth.uid in resource.data.teacherIds
                        && request.resource.data.establishmentId == resource.data.establishmentId);
      allow delete: if isSuperAdmin()
                    || (isAdmin() && isSameEstablishment(resource.data.establishmentId));
    }

    // =============================================
    // CLASSES
    // =============================================
    match /classes/{classId} {
      // Un enseignant affecte lit ses classes, rattache ou non a une ecole :
      // ses listes interrogent teacherIds / mainTeacherId, que la regle doit
      // pouvoir prouver sur la requete elle-meme.
      allow read: if isSuperAdmin()
                  || isSameEstablishment(resource.data.establishmentId)
                  || (isTeacher()
                      && (request.auth.uid in resource.data.teacherIds
                          || request.auth.uid == resource.data.mainTeacherId));
      allow create: if isSuperAdmin()
                    || (isAdmin() && isSameEstablishment(request.resource.data.establishmentId)
                        && classHasNoStudents(request.resource.data));
      allow update: if isSuperAdmin()
                    || (isSameEstablishment(resource.data.establishmentId)
                        && isSameEstablishment(request.resource.data.establishmentId)
                        && classRosterUnchanged()
                        && (isAdmin()
                            || (isTeacher() && request.auth.uid == resource.data.mainTeacherId)));
      allow delete: if isSuperAdmin()
                    || (isAdmin() && isSameEstablishment(resource.data.establishmentId)
                        && classHasNoStudents(resource.data));
    }

    // =============================================
    // CHAPTERS
    // =============================================
    match /{path=**}/chapters/{chapterId} {
      allow read: if isStaff() && mayReadContentScope(contentScopeIdOf(resource.data));
      allow create: if mayWriteLegacyCatalog(request.resource.data);
      allow update: if mayWriteLegacyCatalog(resource.data)
                    && mayWriteLegacyCatalog(request.resource.data);
      allow delete: if isSuperAdmin()
                    || (isAdmin() && mayWriteContentScope(contentScopeIdOf(resource.data)));
    }

    // =============================================
    // LESSONS
    // =============================================
    // Le perimetre vit dans le document. Les lecons anterieures au Content
    // Studio n'en portent pas : elles relevent du programme national, donc
    // du perimetre global.
    function contentScopeIdOf(data) {
      return ('scope' in data && data.scope.type == 'establishment')
        ? data.scope.establishmentId
        : data.get('establishmentId', 'global');
    }

    // Le programme national n'appartient a personne en particulier : seule
    // l'administration y ecrit. Un contenu d'etablissement n'est modifiable
    // que par le personnel de cet etablissement.
    function mayWriteContentScope(scopeId) {
      // L'administration generale n'est rattachee a aucun etablissement :
      // elle publie pour tous. Un administrateur d'etablissement reste borne
      // au sien, et un enseignant aussi.
      return isSuperAdmin()
        || (scopeId == 'global'
              ? false
              : ((isTeacher() || isAdmin())
                 && isSameEstablishment(scopeId)));
    }

    // Keep the established teacher authoring contract on legacy catalog
    // documents. A school administrator never inherits global write access.
    function mayWriteLegacyCatalog(data) {
      return mayWriteContentScope(contentScopeIdOf(data));
    }

    function mayReadContentScope(scopeId) {
      return isAuthenticated()
        && (scopeId == 'global' || isSuperAdmin() || isSameEstablishment(scopeId));
    }

    // Publication and changes to published lessons must pass the server's
    // media validation. Direct authoring remains available for draft text.
    match /{path=**}/lessons/{lessonId} {
      allow read: if isStaff() && mayReadContentScope(contentScopeIdOf(resource.data));
      allow create: if mayWriteContentScope(contentScopeIdOf(request.resource.data))
                    && request.resource.data.get('status', 'draft') in ['draft', 'ai_generated', 'inReview'];
      allow update: if mayWriteContentScope(contentScopeIdOf(resource.data))
                    && mayWriteContentScope(contentScopeIdOf(request.resource.data))
                    && resource.data.get('status', 'draft') != 'published'
                    && request.resource.data.get('status', 'draft') in ['draft', 'ai_generated', 'inReview'];
      allow delete: if isSuperAdmin();
    }

    match /content_catalog_state/{id} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /educational_asset_access/{id} {
      allow read, write: if false;
    }

    // =============================================
    // FLOW ITEMS — publications du fil pedagogique
    // =============================================
    // L'eleve ne lit que ce qui est reellement publie : le filtrage n'est pas
    // laisse au client. Le personnel voit aussi les brouillons de son
    // perimetre, sans quoi il ne pourrait pas relire son propre travail.
    match /flow_items/{itemId} {
      allow read: if isStaff() && mayReadContentScope(contentScopeIdOf(resource.data));
      allow create, update: if false; // saveFlowPublication validates media and audience.
      allow delete: if isSuperAdmin()
                    || (isAdmin()
                        && mayWriteContentScope(
                             contentScopeIdOf(resource.data)));
    }

    // =============================================
    // COURSES FOR STRUCTURED AI GENERATION
    // =============================================
    // Perimetres de contenu :
    // - GLOBAL : programme national (scope absent ou 'global'), lisible par
    //   tout le personnel ; les eleves le recoivent par les callables ;
    // - ESTABLISHMENT : scope.establishmentId, personnel de cette ecole ;
    // - CLASS : documents `classes` (studentIds), regles dediees plus haut.
    // Aucun client eleve ne lit courses ni lesson_assets directement.
    match /courses/{courseId} {
      allow read: if isStaff() && mayReadContentScope(contentScopeIdOf(resource.data));
      allow create: if mayWriteLegacyCatalog(request.resource.data);
      allow update: if mayWriteLegacyCatalog(resource.data)
                    && mayWriteLegacyCatalog(request.resource.data);
      allow delete: if isSuperAdmin()
                    || (isAdmin() && mayWriteContentScope(contentScopeIdOf(resource.data)));
    }

    match /courses/{courseId}/images/{imageId} {
      allow read: if isStaff() && mayReadContentScope(contentScopeIdOf(
        get(/databases/$(database)/documents/courses/$(courseId)).data));
      allow create, update: if mayWriteLegacyCatalog(
        get(/databases/$(database)/documents/courses/$(courseId)).data);
      allow delete: if isSuperAdmin()
        || (isAdmin() && mayWriteContentScope(contentScopeIdOf(
          get(/databases/$(database)/documents/courses/$(courseId)).data)));
    }

    match /courses/{courseId}/generated_quizzes/{quizId} {
      allow read: if isAuthenticated() && (
                    request.auth.uid == resource.data.generatedByUid
                    || (isStaff() && mayReadContentScope(contentScopeIdOf(
                         get(/databases/$(database)/documents/courses/$(courseId)).data)))
                  );
      allow create, update, delete: if false; // Ecriture reservee aux Cloud Functions
    }

    match /courses/{courseId}/generated_summaries/{summaryId} {
      allow read: if isAuthenticated() && (
                    request.auth.uid == resource.data.generatedByUid
                    || (isStaff() && mayReadContentScope(contentScopeIdOf(
                         get(/databases/$(database)/documents/courses/$(courseId)).data)))
                  );
      allow create, update, delete: if false; // Ecriture reservee aux Cloud Functions
    }

    // =============================================
    // LESSON ASSETS
    // =============================================
    match /lesson_assets/{assetId} {
      allow read: if isStaff() && mayReadContentScope(contentScopeIdOf(resource.data));
      allow create: if mayWriteLegacyCatalog(request.resource.data);
      allow update: if mayWriteLegacyCatalog(resource.data)
                    && mayWriteLegacyCatalog(request.resource.data);
      allow delete: if isSuperAdmin()
                    || (isAdmin() && mayWriteContentScope(contentScopeIdOf(resource.data)));
    }

    // =============================================
    // QUIZZES
    // =============================================
    match /quizzes/{quizId} {
      // Les élèves chargent les quiz via les callables qui projettent une
      // représentation publique sans corrigé. La lecture directe reste
      // réservée aux auteurs afin de ne pas exposer les anciens documents qui
      // contiennent encore leurs réponses pendant la migration.
      allow read: if isStaff() && mayReadContentScope(contentScopeIdOf(resource.data));
      allow create: if mayWriteLegacyCatalog(request.resource.data);
      allow update: if mayWriteLegacyCatalog(resource.data)
                    && mayWriteLegacyCatalog(request.resource.data);
      allow delete: if isSuperAdmin()
                    || (isAdmin() && mayWriteContentScope(contentScopeIdOf(resource.data)));
    }

    match /quiz_answer_keys/{quizId} {
      allow read: if isStaff() && mayReadContentScope(contentScopeIdOf(resource.data));
      allow create, update: if mayWriteContentScope(contentScopeIdOf(
          getAfter(/databases/$(database)/documents/quizzes/$(quizId)).data));
      allow delete: if isSuperAdmin()
        || (isAdmin() && mayWriteContentScope(contentScopeIdOf(
          get(/databases/$(database)/documents/quizzes/$(quizId)).data)));
    }

    // =============================================
    // QUIZ ATTEMPTS
    // =============================================
    match /quiz_attempts/{attemptId} {
      allow read: if isAuthenticated() && (
                    request.auth.uid == resource.data.studentId
                    || isStaffForStudent(resource.data.studentId)
                    || isSuperAdmin()
                    || isLinkedParent(resource.data.studentId)
                  );
      allow create, update, delete: if false; // Ecriture reservee aux Cloud Functions
    }

    // =============================================
    // PROGRESS
    // =============================================
    match /progress/{progressId} {
      allow read: if isAuthenticated() && (
                    request.auth.uid == resource.data.studentId
                    || isStaffForStudent(resource.data.studentId)
                    || isSuperAdmin()
                    || isLinkedParent(resource.data.studentId)
                  );
      allow create, update, delete: if false; // Ecriture reservee aux Cloud Functions
    }

    // =============================================
    // BADGES
    // =============================================
    match /badges/{badgeId} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // =============================================
    // STREAKS
    // =============================================
    match /streaks/{uid} {
      allow read: if isOwner(uid)
                  || isSuperAdmin()
                  || isLinkedParent(uid);
      allow create, update, delete: if false; // Ecriture reservee aux Cloud Functions
    }

    // =============================================
    // ANNOUNCEMENTS
    // =============================================
    match /announcements/{announcementId} {
      // Contrat en deux temps. Les versions deja installees lisent encore les
      // annonces sans nommer l'ecole : resserrer maintenant casserait leurs
      // tableaux de bord. Les nouvelles versions bornent leurs requetes a
      // l'ecole ; une fois adoptees, la lecture deviendra
      // isSuperAdmin() || isSameEstablishment(resource.data.establishmentId).
      allow read: if isAuthenticated();
      allow create: if (isAdmin() || isSuperAdmin())
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.establishmentId is string
                    // L'administration generale publie pour l'ecole de son choix.
                    && (isSuperAdmin()
                        || isSameEstablishment(request.resource.data.establishmentId))
                    && request.resource.data.title is string
                    && request.resource.data.message is string
                    && request.resource.data.audience in [
                      'Tout l\'établissement',
                      'Élèves',
                      'Parents',
                      'Enseignants',
                      'Administration'
                    ]
                    || isAssignedTeacherForClass(request.resource.data.classId)
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.establishmentId is string
                    && isSameEstablishment(request.resource.data.establishmentId)
                    && request.resource.data.audience == 'Classe'
                    && request.resource.data.title is string
                    && request.resource.data.message is string;
      // Une annonce publiée est immuable : le fan-out de notifications est
      // idempotent et ne doit jamais diverger du message source.
      allow update: if false;
      allow delete: if isSuperAdmin()
                    || (isAdmin() && isSameEstablishment(resource.data.establishmentId));
    }

    // =============================================
    // NOTIFICATIONS
    // =============================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if false; // Créées uniquement via Cloud Functions
      allow update: if isAuthenticated()
                    && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['readAt']);
      allow delete: if false;
    }

    // Un appareil peut uniquement publier son propre jeton. L'envoi reste
    // exclusivement serveur via Firebase Admin.
    match /notification_devices/{installationId} {
      allow read: if false;
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                      'userId', 'token', 'platform',
                      'authorizationStatus', 'updatedAt'
                    ]);
      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly([
                           'token', 'platform',
                           'authorizationStatus', 'updatedAt'
                         ]);
      allow delete: if isAuthenticated()
                    && resource.data.userId == request.auth.uid;
    }

    // Registre d'idempotence du tuteur (15 min) : serveur uniquement. Il porte
    // la derniere reponse du compagnon, jamais la question de l'eleve.
    match /tutor_requests/{requestKey} {
      allow read, write: if false;
    }

    // =============================================
    // AI PERSONAS
    // =============================================
    match /ai_personas/{personaId} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // =============================================
    // AI CONVERSATIONS
    // =============================================
    // Aucune version de l'application n'ecrit ici : l'historique du
    // compagnon reste sur l'appareil. Ouvrir l'ecriture laissait stocker
    // des documents arbitraires sans borne.
    match /ai_conversations/{conversationId} {
      allow read, write: if false;
    }

    // =============================================
    // RECOMMENDATIONS
    // =============================================
    match /recommendations/{recommendationId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.studentId;
      allow create: if false; // Créées uniquement via Cloud Functions / AI
      // Aucun client ne les modifie ; l'ancienne regle laissait reecrire tout
      // le document, studentId compris.
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // =============================================
    // MANUAL MOBILE MONEY (server-authoritative)
    // =============================================
    match /mobile_money_offers/{offerId} {
      // Amounts and recipient numbers are projected through an authenticated
      // callable. Direct access would bypass its role and school scoping.
      allow read, create, update, delete: if false;
    }

    match /mobile_money_payment_requests/{paymentRequestId} {
      allow read: if isAuthenticated() && (
                    request.auth.uid == resource.data.parentId
                    || ((isAdmin() || isSuperAdmin())
                        && isSameEstablishment(resource.data.establishmentId))
                  );
      // Submission and review are transactionally validated by Cloud Functions.
      allow create, update, delete: if false;
    }

    match /mobile_money_reference_keys/{referenceHash} {
      // Anti-replay keys intentionally reveal neither existence nor metadata.
      allow read, create, update, delete: if false;
    }

    match /entitlements/{entitlementId} {
      allow read: if isAuthenticated() && (
                    request.auth.uid == resource.data.userId
                    || ((isAdmin() || isSuperAdmin())
                        && isSameEstablishment(resource.data.establishmentId))
                  );
      // Only a successful server-side review grants or extends access.
      allow create, update, delete: if false;
    }

    // =============================================
    // REPORTS
    // =============================================
    // =============================================
    // MODERATION QUEUE
    // =============================================
    // L'administration generale voit et traite tout ; une direction, ce qui
    // releve de son ecole. Le traitement ne touche qu'a la decision.
    match /moderation_queue/{entryId} {
      allow read: if isSuperAdmin()
                  || (isAdmin() && isSameEstablishment(resource.data.establishmentId));
      allow update: if (isSuperAdmin()
                        || (isAdmin() && isSameEstablishment(resource.data.establishmentId)))
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'reviewedBy', 'reviewedAt'])
                    && request.resource.data.reviewedBy == request.auth.uid;
      allow create, delete: if isSuperAdmin();
    }

    match /reports/{reportId} {
      allow read: if isSuperAdmin()
                  || (isAdmin() && isSameEstablishment(resource.data.establishmentId))
                  || (isTeacher() && request.auth.uid == resource.data.generatedBy);
      allow create: if isSuperAdmin()
                    || ((isTeacher() || isAdmin())
                        && isSameEstablishment(request.resource.data.establishmentId));
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // =============================================
    // SETTINGS
    // =============================================
    // Demande de suppression : le titulaire suit son echeance, la
    // super-administration voit toutes les demandes. Ecriture serveur seule.
    match /account_deletion_requests/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isSuperAdmin();
      allow write: if false;
    }

    match /account_management_audit/{eventId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // =============================================
    // FAMILY ACCESS (server-only)
    // =============================================
    // Code d'acces eleve : empreintes HMAC, index inverse et compteur
    // anti-bruteforce. Aucun client, pas meme l'eleve, son parent ou la
    // super-administration, ne lit une empreinte : tout passe par les callables.
    match /student_access_credentials/{studentId} {
      allow read, write: if false;
    }

    match /student_access_codes/{lookupKey} {
      allow read, write: if false;
    }

    match /student_access_attempts/{clientKey} {
      allow read, write: if false;
    }

    // Enfant sans telephone dont le parent a ouvert l'acces : identite en
    // attente de profil, creations et quotas. Serveur seulement.
    match /pending_student_accounts/{studentId} {
      allow read, write: if false;
    }

    match /child_access_requests/{requestId} {
      allow read, write: if false;
    }

    match /child_access_quotas/{parentId} {
      allow read, write: if false;
    }

    // Journaux sans secret : emissions, rotations, migrations du telephone
    // familial. Lisibles par la seule super-administration, pour le support.
    match /student_access_audit/{eventId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /auth_phone_migrations/{phoneKey} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Aucune version de l'application n'utilise settings/{uid} : les
    // preferences vivent sur l'appareil ou dans student_profiles.
    match /settings/{uid} {
      allow read, write: if false;
    }
  }
}
